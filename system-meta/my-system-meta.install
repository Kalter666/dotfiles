# Runs as root under pacman: system-level steps only.
# Per-user setup (docker group, rustup, stow) lives in bootstrap.sh,
# which runs as the actual user.

post_install() {
    echo "--- Post-Installation Automations ---"

    if ! getent group docker > /dev/null; then
        groupadd docker
    fi

    systemctl enable --now docker.service
    echo ">> Docker service enabled."
}

post_upgrade() {
    post_install
}
